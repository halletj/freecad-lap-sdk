  discretize(QuasiDeflection: float, First: float, Last: float) -> list[Vector]
  fixWire()
  makeEvolved(Profile: Wire, Join: int, AxeProf: bool, Solid: bool, ProfOnSpine: bool, Tolerance: float) -> Shape
  makeHomogenousWires() -> Wire | Any
  makeOffset() -> Shape
  makePipe() -> Shape
  makePipeShell() -> Shape
