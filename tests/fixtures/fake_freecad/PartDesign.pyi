import FreeCAD
import Part

class Feature(Part.Feature):
    @property
    def BaseFeature(self) -> 'Feature': ...

class Body(FreeCAD.GeoFeature):
    """A PartDesign Body containing a linear feature chain."""
    @property
    def Tip(self) -> Feature: ...
    @property
    def BaseFeature(self) -> Feature: ...
    @property
    def Origin(self) -> FreeCAD.Base: ...
    @property
    def Group(self) -> list[FreeCAD.DocumentObject]: ...
    def newObject(self, type: str, name: str) -> FreeCAD.DocumentObject: ...

class Pad(Feature):
    """A pad (extrusion) feature."""
    @property
    def Profile(self) -> FreeCAD.DocumentObject: ...
    @property
    def Length(self) -> float: ...
    @property
    def Reversed(self) -> bool: ...
    @property
    def Symmetric(self) -> bool: ...
    @property
    def Midplane(self) -> bool: ...

class Pocket(Feature):
    """A pocket (subtractive extrusion) feature."""
    @property
    def Profile(self) -> FreeCAD.DocumentObject: ...
    @property
    def Length(self) -> float: ...
    @property
    def Type(self) -> str: ...

class Revolution(Feature):
    """A revolution feature."""
    @property
    def Profile(self) -> FreeCAD.DocumentObject: ...
    @property
    def Axis(self) -> FreeCAD.Vector: ...
    @property
    def Angle(self) -> float: ...

class Fillet(Feature):
    """A fillet feature."""
    @property
    def Base(self) -> FreeCAD.DocumentObject: ...
    @property
    def Radius(self) -> float: ...

class Chamfer(Feature):
    """A chamfer feature."""
    @property
    def Base(self) -> FreeCAD.DocumentObject: ...
    @property
    def Size(self) -> float: ...
