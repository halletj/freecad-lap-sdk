class Base:
    @property
    def isDerivedFrom(self) -> str: ...

class Vector:
    @property
    def x(self) -> float: ...
    @x.setter
    def x(self, value: float) -> None: ...
    @property
    def y(self) -> float: ...
    @property
    def z(self) -> float: ...
    def __init__(self, x: float = 0, y: float = 0, z: float = 0) -> None: ...
    def add(self, other: 'Vector') -> 'Vector': ...
    def sub(self, other: 'Vector') -> 'Vector': ...
    def cross(self, other: 'Vector') -> 'Vector': ...
    def dot(self, other: 'Vector') -> float: ...
    def normalize(self) -> 'Vector': ...
    @property
    def Length(self) -> float: ...

class Placement:
    @property
    def Base(self) -> Vector: ...
    @property
    def Rotation(self) -> 'Rotation': ...
    def __init__(self, base: Vector = ..., rotation: 'Rotation' = ...) -> None: ...
    def move(self, displacement: Vector) -> None: ...

class Rotation:
    @property
    def Axis(self) -> Vector: ...
    @property
    def Angle(self) -> float: ...

class Document:
    @property
    def Name(self) -> str: ...
    @property
    def Objects(self) -> list: ...
    @property
    def ActiveObject(self) -> 'DocumentObject': ...
    def addObject(self, type: str, name: str) -> 'DocumentObject': ...
    def removeObject(self, name: str) -> None: ...
    def recompute(self) -> None: ...
    def getObject(self, name: str) -> 'DocumentObject': ...
    def save(self) -> None: ...
    def saveAs(self, path: str) -> None: ...

class DocumentObject:
    @property
    def Name(self) -> str: ...
    @property
    def Label(self) -> str: ...
    @property
    def TypeId(self) -> str: ...
    @property
    def Document(self) -> Document: ...
    @property
    def InList(self) -> list: ...
    @property
    def OutList(self) -> list: ...

class GeoFeature(DocumentObject):
    @property
    def Placement(self) -> Placement: ...
    @property
    def Shape(self) -> 'Part.Shape': ...

class Console:
    @staticmethod
    def PrintMessage(msg: str) -> None: ...
    @staticmethod
    def PrintWarning(msg: str) -> None: ...
    @staticmethod
    def PrintError(msg: str) -> None: ...

class Units:
    MilliMetre: int = 1
    Metre: int = 2
    Inch: int = 3
